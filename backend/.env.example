# ── AcademIQ backend — copy to `.env` for local development ─────────────────
# On Vercel (backend project), set these in Project → Settings → Environment Variables.

# --- Required (production) --------------------------------------------------
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DATABASE_NAME=todo_db

# Generate a strong random secret for production (never use the dev default).
JWT_SECRET_KEY=DEV-ONLY-change-me-in-production-academiq-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins — include your Vercel frontend URL(s).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Environment ------------------------------------------------------------
# development = local defaults | production = strict validation
ENVIRONMENT=development

# --- External ML service (optional — Hugging Face Docker Space) -------------
# ML_SERVICE_URL=https://your-space.hf.space
# ML_SERVICE_TIMEOUT_SECONDS=5

# --- Optional bootstrap (idempotent — safe on first deploy) -----------------
# BOOTSTRAP_STUDENTS=true
# BOOTSTRAP_ADMIN=true

# --- Legacy session routes (admin / extension) ------------------------------
SESSION_COOKIE_NAME=academiq_session
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- Frontend / email -------------------------------------------------------
APP_LOGIN_URL=http://localhost:3000/signin

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AcademIQ <no-reply@academiq.local>
SMTP_USE_TLS=true

# --- Initial admin (used by `python -m app.scripts.seed_admin`) -------------
ADMIN_EMAIL=admin@academiq.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=AcademIQ Admin
